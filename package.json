{
  "name": "sirah-journey",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "uv run api.py",
    "build": "node scripts/export_guide_context.js && vite build",
    "check": "node scripts/export_guide_context.js --check && node scripts/content/compile.js --check && node scripts/content/chapters.js --check && uv run python -m py_compile api.py guide.py",
    "guide:context": "node scripts/export_guide_context.js",
    "content": "node scripts/content/compile.js",
    "preview": "vite preview --host 127.0.0.1 --port 5100"
  },
  "dependencies": {
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "svelte": "5.55.9",
    "tailwind-merge": "^3.7.0",
    "three": "0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mustafaj/oxfmt": "0.65.0-svelte.10",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@wuchale/svelte": "^0.21.4",
    "navgo": "6.0.12",
    "tailwindcss": "4.3.3",
    "vite": "8.0.14",
    "vite-plugin-domain": "2.0.5",
    "wuchale": "^0.26.7"
  }
}
