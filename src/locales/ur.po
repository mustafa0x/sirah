msgid "Evidence shown. Each point is a cited passage, coloured by kind."
msgstr "شواہد دکھائے گئے۔ ہر نقطہ ایک حوالہ شدہ اقتباس ہے، جو اپنی قسم کے لحاظ سے رنگین ہے۔"

#: src/routes/Journey.svelte
#, ai
msgid "Evidence hidden."
msgstr "شواہد چھپا دیے گئے۔"

