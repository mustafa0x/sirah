msgid "Show evidence on the map"
msgstr "نقشے پر شواہد دکھائیں"

#: src/routes/Journey.svelte
#, ai
msgid "Hide timeline"
msgstr "ٹائم لائن چھپائیں"

#: src/routes/Journey.svelte
#, ai
msgid "Show timeline"
msgstr "ٹائم لائن دکھائیں"

#: src/routes/Journey.svelte
#, ai
msgid "How each date is known"
msgstr "ہر تاریخ کیسے معلوم ہوئی"

