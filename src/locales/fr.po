#, ai
msgid "Quba"
msgstr "Quba"

#: src/lib/scene-manifest.js
#, ai
msgid "The first stop on reaching Madinah, among Bani ‘Amr ibn ‘Awf."
msgstr "La première étape en atteignant Médine, chez les Bani ‘Amr ibn ‘Awf."

