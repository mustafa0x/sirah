#: src/content/first-chapter.js
#, ai
msgid "The selected passage describes the mosque site and the Prophet ﷺ carrying bricks with the builders."
msgstr "Petikan yang dipilih menerangkan tentang tapak masjid dan Nabi ﷺ membawa batu bata bersama-sama para pembina."

