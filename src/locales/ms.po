#: src/content/first-chapter.js
#, ai
msgid "The selected arrival account describes people waiting and the stay among Bani ‘Amr ibn ‘Awf."
msgstr "Riwayat ketibaan yang dipilih menerangkan tentang orang ramai yang sedang menunggu dan tempoh tinggal dalam kalangan Bani ‘Amr ibn ‘Awf."

#: src/content/first-chapter.js
#, ai
