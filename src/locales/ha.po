msgstr "Rawayar ta nuna an yi zaman darare uku a cikin kogo a nan."

#: src/lib/scene-manifest.js
#, ai
msgid "The coastal way"
msgstr "Hanyar gabar teku"

#: src/lib/scene-manifest.js
#, ai
msgid "The guide led them by the coast. This line is schematic, not a measured route."
msgstr "Jagoran ya bi da su ta gabar teku. Wannan layin na zane ne kawai, ba wai cikakkiyar taswirar hanya ba."

#: src/content/lenses.js
#: src/content/lenses.js
