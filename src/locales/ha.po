#: src/content/timeline.js
#, ai
msgid "Ibn Kathir, al-Bidayah wa al-Nihayah"
msgstr "Ibn Kathir, al-Bidayah wa al-Nihayah"

#: src/content/first-chapter.js
#, ai
msgid "Ibn Kathir’s commentary on the Turath page explains the reassurance through Allah’s help, support, and strengthening."
msgstr "Bayanin Ibn Kathir a shafin Turath ya bayyana kwantar da hankalin ta hanyar taimakon Allah, goyon bayansa, da kuma ƙarfafawarsa."

#: src/content/first-chapter.js
#, ai
msgid "The selected arrival account describes people waiting and the stay among Bani ‘Amr ibn ‘Awf."
msgstr "Rawayar isarwa da aka zaɓa tana bayyana mutanen da ke jiran isowarsu da kuma zama a tsakanin Bani ‘Amr ibn ‘Awf."

#: src/content/first-chapter.js
#, ai
msgid "The selected passage describes the mosque site and the Prophet ﷺ carrying bricks with the builders."
msgstr "Nassin da aka zaɓa yana bayyana wurin masallacin da kuma yadda Annabi ﷺ ya riƙa ɗaukar tubali tare da masu ginin."

#: src/content/first-chapter.js
#, ai
msgid "It does not establish the exact appearance of buildings in the scene."
msgstr "Ba ya nuna ainihin yadda gine-ginen suke a wannan lokacin."

#: src/content/first-chapter.js
#, ai
msgid "Al-Sa‘di"
msgstr "Al-Sa‘di"

#: src/content/first-chapter.js
#, ai
msgid "Attribution recorded in the cited work"
msgstr "An rubuta sunan marubucin a cikin littafin da aka ambata"

#: src/content/first-chapter.js
#, ai
msgid "Turath book_id/page_id retrieved from category 24; publication approval pending"
msgstr "An samo book_id/page_id na Turath daga rukunoni na 24; amincewa da wallafawa yana jiran aiki"

#: src/lib/guide-provider.js
#, ai
msgid "The selected evidence does not establish an exact route. It describes a coastal way, while this overview is schematic rather than a measured itinerary."
msgstr "Hujjojin da aka zaɓa ba su nuna takamaiman hanya ba. Suna bayyana hanyar gabar teku ne kawai, yayin da wannan bayyani na zane ne kawai ba wai cikakkiyar taswirar hanya ba."

#: src/lib/guide-provider.js
#, ai
msgid "They hired a skilled guide, entrusted him with two riding animals, and arranged to meet him at Thawr. The account says he led them by the coastal way."
msgstr "Sun ɗauki gogaggen jagora aiki, suka amince masa da dabbobin hawa guda biyu, kuma suka tsara haɗuwa da shi a Thawr. Rawayar ta ce ya bi da su ta hanyar gabar teku."

#: src/lib/guide-provider.js
#, ai
msgid "The selected account says that they remained in the cave for three nights."
msgstr "Rawayar da aka zaɓa ta ce sun zauna a cikin kogon har tsawon darare uku."

#: src/lib/guide-provider.js
#, ai
msgid "The preparations account describes provisions packed in a bag and Asma bint Abi Bakr using part of her waist-belt to tie its opening."
msgstr "Rawayar shirye-shiryen tana bayyana yadda aka zuba guzuri a cikin jaka da kuma yadda Asma bint Abi Bakr ta yi amfani da sashin ɗaurin gindinta don ɗure bakin jakar."

#: src/lib/guide-provider.js
#, ai
msgid "The arrival account describes Muslims waiting, the stay among Bani ‘Amr ibn ‘Awf, and later building work at the mosque site."
msgstr "Rawayar isarwa tana bayyana yadda Musulmai suke jira, zaman da aka yi a tsakanin Bani ‘Amr ibn ‘Awf, da kuma aikin ginin masallaci da aka yi daga baya."

#: src/lib/guide-provider.js
#, ai
msgid "The selected evidence does not establish an answer to that question. The available source records are shown below."
msgstr "Hujjojin da aka zaɓa ba su bayar da amsar wannan tambayar ba. Ana iya ganin bayanan da ke akwai a ƙasa."

#: src/content/lenses.js
