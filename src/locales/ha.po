#: src/content/lenses.js
#: src/lib/scene-manifest.js
#, ai
msgid "Quba"
msgstr "Quba"

#: src/lib/scene-manifest.js
#, ai
msgid "The first stop on reaching Madinah, among Bani ‘Amr ibn ‘Awf."
msgstr "Tasha ta farko lokacin da aka isa Madinah, a tsakanin Bani ‘Amr ibn ‘Awf."

#: src/routes/Journey.svelte
#: src/routes/Journey.svelte
#, ai
msgid "Turn sound off"
msgstr "Kashe sauti"

