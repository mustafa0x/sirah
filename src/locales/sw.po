#: src/lib/guide-provider.js
#, ai
msgid "‘Amir ibn Fuhayrah and the guide went with them when they continued, and the guide led them by the coastal way. The guide’s personal name and the precise route are not established here."
msgstr "‘Amir ibn Fuhayrah na kiongozi wa njia waliondoka nao walipoendelea na safari, na kiongozi huyo aliwaongoza kupitia njia ya pwani. Jina la kibinafsi la kiongozi huyo na njia sahihi havijathibitishwa hapa."

#: src/lib/guide-provider.js
#, ai
msgid "‘Abdullah ibn Abi Bakr brought news of plans against them after darkness and returned to Makkah before daybreak."
msgstr "‘Abdullah ibn Abi Bakr alikuwa akileta habari za mipango dhidi yao baada ya giza kuingia na kurejea Makkah kabla ya mapambazuko."

#: src/lib/guide-provider.js
#, ai
msgid "‘Amir ibn Fuhayrah tended the flock and brought milk near the cave during the three nights."
msgstr "‘Amir ibn Fuhayrah alichunga kundi la wanyama na kuleta maziwa karibu na pango wakati wa masiku hayo matatu."

#: src/content/first-chapter.js
