msgid "Ibn Sa‘d, al-Tabaqat al-Kubra, 1/192"
msgstr "İbn Sa‘d, et-Tabakâtü’l-kübrâ, 1/192"

#: src/content/text.generated.js
msgid "Ibn Sa‘d, al-Tabaqat al-Kubra, 1/193"
msgstr "İbn Sa‘d, et-Tabakâtü’l-kübrâ, 1/193"

#: src/content/text.generated.js
msgid "Al-Tabari, Tarikh al-Rusul wa al-Muluk, 2/369"
msgstr "et-Taberî, Târîhu’r-rusül ve’l-mülûk, 2/369"

#: src/content/text.generated.js
msgid "Ibn Hisham, al-Sirah al-Nabawiyyah, 1/480"
