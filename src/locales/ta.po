msgid "Answer recorded."
msgstr "பதில் பதிவு செய்யப்பட்டது."

#: src/routes/Journey.svelte
msgid "Level"
msgstr "நிலை"

#: src/lib/ChapterReader.svelte
#: src/routes/Journey.svelte
msgid "Beginner"
msgstr "தொடக்கநிலை"

#: src/lib/ChapterReader.svelte
#: src/routes/Journey.svelte
