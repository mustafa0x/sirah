msgstr "கடற்கரை வழி"

#: src/lib/scene-manifest.js
#, ai
msgid "The guide led them by the coast. This line is schematic, not a measured route."
msgstr "வழிகாட்டி அவர்களைக் கடற்கரை வழியாக அழைத்துச் சென்றார். இந்த வழித்தடம் ஒரு வரைபட விளக்கமே தவிர, அளவிடப்பட்ட பாதை அல்ல."

#: src/content/lenses.js
#: src/content/lenses.js
#: src/lib/scene-manifest.js
