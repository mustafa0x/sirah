#: src/routes/Journey.svelte
#: src/routes/Journey.svelte
#, ai
msgid "Young learners"
msgstr "ছোটদের জন্য"

#: src/routes/Journey.svelte
#: src/routes/Journey.svelte
#: src/routes/Journey.svelte
