#: src/routes/Journey.svelte
#, ai
msgid "Along the way"
msgstr "على الطريق"

#: src/routes/Journey.svelte
#: src/routes/Journey.svelte
#: src/routes/Journey.svelte
#, ai
msgid "Close detail"
msgstr "إغلاق التفصيل"

#: src/content/timeline.js
#, ai
msgid "Leaving Makkah"
msgstr "الخروج من مكة"

#: src/content/timeline.js
#, ai
msgid "Night of 27 Safar · 12–13 September 622"
msgstr "ليلة ٢٧ صفر · ١٢–١٣ سبتمبر ٦٢٢"

#: src/content/timeline.js
#, ai
msgid "The night of departure is in the accounts. Its place in the calendar is a modern reckoning."
msgstr "ليلة الخروج مذكورة في الروايات، أما موضعها من التقويم فحساب معاصر."

#: src/content/timeline.js
#, ai
msgid "The nights before Friday, Saturday and Sunday"
msgstr "ليلة الجمعة وليلة السبت وليلة الأحد"

#: src/content/timeline.js
#, ai
msgid "Three nights is in al-Bukhari. Naming them after the days of the week follows a modern reckoning."
msgstr "الليالي الثلاث في البخاري، وتسميتها بأيام الأسبوع تتبع حسابًا معاصرًا."

#: src/content/timeline.js
#, ai
msgid "The guide arrives"
msgstr "وصول الدليل"

#: src/content/timeline.js
#, ai
msgid "Night of Monday, 1 Rabi‘ al-Awwal · 16 September 622"
msgstr "ليلة الإثنين، غرة ربيع الأول · ١٦ سبتمبر ٦٢٢"

#: src/content/timeline.js
#, ai
msgid "The guide came with the two mounts after the third night, as arranged. The calendar date is a modern reckoning."
msgstr "جاء الدليل بالراحلتين بعد الليلة الثالثة كما اتُّفق. والتاريخ في التقويم حساب معاصر."

#: src/content/timeline.js
#, ai
msgid "On the coastal road"
msgstr "على طريق الساحل"

#: src/content/timeline.js
#, ai
msgid "About a week"
msgstr "نحو أسبوع"

#: src/content/timeline.js
#, ai
msgid "The accounts give the order of what happened on the road, but no days. The pursuit and the tent of Umm Ma‘bad fall somewhere in this week."
msgstr "تذكر الروايات ترتيب ما وقع في الطريق دون أيامه. ويقع لحاق سراقة وخيمة أم معبد في مكان ما من هذا الأسبوع."

#: src/content/timeline.js
#, ai
msgid "Arrival at Quba"
msgstr "الوصول إلى قباء"

#: src/content/timeline.js
#, ai
msgid "Monday · 8 Rabi‘ al-Awwal · 23 September 622"
msgstr "الإثنين · ٨ ربيع الأول · ٢٣ سبتمبر ٦٢٢"

#: src/content/timeline.js
#, ai
msgid "The account in al-Bukhari says it was a Monday in Rabi‘ al-Awwal. The day of the month is a modern reckoning."
msgstr "تذكر رواية البخاري أنه كان يوم الإثنين من شهر ربيع الأول، أما اليوم من الشهر فحساب معاصر."

#: src/content/timeline.js
#, ai
msgid "The stay at Quba"
msgstr "الإقامة في قباء"

#: src/content/timeline.js
#, ai
msgid "Four days, or more than ten nights"
msgstr "أربعة أيام، أو بضع عشرة ليلة"

#: src/content/timeline.js
#, ai
msgid "Ibn Ishaq gives Monday to Thursday. The report in al-Bukhari says more than ten nights, and Banu ‘Amr ibn ‘Awf said eighteen. Ibn Kathir sets the reports side by side without settling it."
msgstr "يذكر ابن إسحاق الإثنين إلى الخميس، وفي رواية البخاري بضع عشرة ليلة، وقال بنو عمرو بن عوف ثماني عشرة ليلة. ويورد ابن كثير الروايات جنبًا إلى جنب دون أن يحسم."

#: src/content/timeline.js
#, ai
msgid "The first Friday, and Madinah"
msgstr "أول جمعة، والمدينة"

#: src/content/timeline.js
#, ai
msgid "Friday · 12 Rabi‘ al-Awwal · 27 September 622"
msgstr "الجمعة · ١٢ ربيع الأول · ٢٧ سبتمبر ٦٢٢"

#: src/content/timeline.js
#, ai
msgid "That it was a Friday is in the early reports. The calendar date is a modern reckoning, and it follows the four-day stay."
msgstr "كونه يوم جمعة مذكور في الروايات المتقدمة، أما التاريخ في التقويم فحساب معاصر يتبع الإقامة أربعة أيام."

