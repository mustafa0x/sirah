#: src/lib/scene-manifest.js
#, ai
msgid "The account places a three-night stay in a cave here."
msgstr "تذكر الرواية الإقامة ثلاث ليال في غار هنا."

#: src/lib/scene-manifest.js
#, ai
msgid "The coastal way"
msgstr "طريق السواحل"

