#: src/content/first-chapter.js
msgid "Connect preparations, the stay at Thawr, the onward journey, and arrival while distinguishing an illustration from its evidence."
msgstr "Connect preparations, the stay at Thawr, the onward journey, and arrival while distinguishing an illustration from its evidence."

#: src/content/first-chapter.js
#: src/lib/guide-provider.js
msgid "How did the journey continue after the cave?"
msgstr "How did the journey continue after the cave?"

#: src/content/first-chapter.js
#: src/lib/guide-provider.js
