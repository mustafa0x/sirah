#: src/content/timeline.js
msgid "Night of 27 Safar · 12–13 September 622"
msgstr "Night of 27 Safar · 12–13 September 622"

#: src/content/timeline.js
msgid "The night of departure is in the accounts. Its place in the calendar is a modern reckoning."
msgstr "The night of departure is in the accounts. Its place in the calendar is a modern reckoning."

#: src/content/timeline.js
msgid "The nights before Friday, Saturday and Sunday"
msgstr "The nights before Friday, Saturday and Sunday"

#: src/content/timeline.js
msgid "Three nights is in al-Bukhari. Naming them after the days of the week follows a modern reckoning."
msgstr "Three nights is in al-Bukhari. Naming them after the days of the week follows a modern reckoning."

#: src/content/timeline.js
msgid "The guide arrives"
msgstr "The guide arrives"

#: src/content/timeline.js
msgid "Night of Monday, 1 Rabi‘ al-Awwal · 16 September 622"
msgstr "Night of Monday, 1 Rabi‘ al-Awwal · 16 September 622"

#: src/content/timeline.js
msgid "The guide came with the two mounts after the third night, as arranged. The calendar date is a modern reckoning."
msgstr "The guide came with the two mounts after the third night, as arranged. The calendar date is a modern reckoning."

#: src/content/timeline.js
msgid "On the coastal road"
msgstr "On the coastal road"

#: src/content/timeline.js
msgid "About a week"
msgstr "About a week"

#: src/content/timeline.js
msgid "The accounts give the order of what happened on the road, but no days. The pursuit and the tent of Umm Ma‘bad fall somewhere in this week."
msgstr "The accounts give the order of what happened on the road, but no days. The pursuit and the tent of Umm Ma‘bad fall somewhere in this week."

#: src/content/timeline.js
msgid "Arrival at Quba"
msgstr "Arrival at Quba"

#: src/content/timeline.js
msgid "Monday · 8 Rabi‘ al-Awwal · 23 September 622"
msgstr "Monday · 8 Rabi‘ al-Awwal · 23 September 622"

#: src/content/timeline.js
msgid "The account in al-Bukhari says it was a Monday in Rabi‘ al-Awwal. The day of the month is a modern reckoning."
msgstr "The account in al-Bukhari says it was a Monday in Rabi‘ al-Awwal. The day of the month is a modern reckoning."

#: src/content/timeline.js
msgid "The stay at Quba"
msgstr "The stay at Quba"

#: src/content/timeline.js
msgid "Four days, or more than ten nights"
msgstr "Four days, or more than ten nights"

#: src/content/timeline.js
msgid "Ibn Ishaq gives Monday to Thursday. The report in al-Bukhari says more than ten nights, and Banu ‘Amr ibn ‘Awf said eighteen. Ibn Kathir sets the reports side by side without settling it."
msgstr "Ibn Ishaq gives Monday to Thursday. The report in al-Bukhari says more than ten nights, and Banu ‘Amr ibn ‘Awf said eighteen. Ibn Kathir sets the reports side by side without settling it."

#: src/content/timeline.js
msgid "The first Friday, and Madinah"
msgstr "The first Friday, and Madinah"

#: src/content/timeline.js
msgid "Friday · 12 Rabi‘ al-Awwal · 27 September 622"
msgstr "Friday · 12 Rabi‘ al-Awwal · 27 September 622"

#: src/content/timeline.js
msgid "That it was a Friday is in the early reports. The calendar date is a modern reckoning, and it follows the four-day stay."
msgstr "That it was a Friday is in the early reports. The calendar date is a modern reckoning, and it follows the four-day stay."

